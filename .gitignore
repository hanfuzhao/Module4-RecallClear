# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store

# Secrets
.env
*.key

# Large / regenerable data. The small curated files needed to reproduce the
# demo are force-added (see README "What is committed").
data/raw/*.json
data/raw/*.jsonl
data/raw/*.zip
data/raw/*.probed.txt
!data/raw/README.md

# The training corpus regenerates from the raw download in about ten seconds
# (`make features`), so it is not worth 100 MB of repository history. The test
# split is committed because the deployed app serves its demo notices from it.
data/processed/train.jsonl
data/processed/recall_cards.jsonl

# Training scratch: checkpoints and merged full-precision weights are large.
# Only the LoRA adapter (~10 MB) is committed, under models/adapter/.
models/checkpoints/
models/merged/
models/*.bin
models/*.safetensors
runs/
wandb/

# Local caches
.cache/
*.log

# Pitch materials (script, slide deck, deck generator) are presentation
# assets, not part of the submitted codebase. They stay local-only.
docs/
scripts/make_deck.py
